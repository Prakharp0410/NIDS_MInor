# Edge-AI Sentinel: FastAPI dashboard served by uvicorn.
[Unit]
Description=Edge-AI Sentinel NIPS dashboard (FastAPI + uvicorn)
After=edge-sentinel-gateway.service network.target
StartLimitIntervalSec=0

[Service]
Type=simple
# Root lets /blocked_threats read the live iptables chain to prove each block
# is enforced and count dropped packets, and lets it open the root-owned
# alerts database that the engine writes.
User=root
WorkingDirectory=@APP_DIR@
Environment=PYTHONUNBUFFERED=1
Environment=EDGE_DASHBOARD_HOST=0.0.0.0
Environment=EDGE_DASHBOARD_PORT=8000
EnvironmentFile=-/etc/edge-sentinel/edge-sentinel.env
ExecStart="@PYTHON@" -m uvicorn dashboard.api:app --host ${EDGE_DASHBOARD_HOST} --port ${EDGE_DASHBOARD_PORT}
Restart=always
RestartSec=3
RestartSteps=5
RestartMaxDelaySec=60
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
